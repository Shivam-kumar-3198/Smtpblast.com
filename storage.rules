rules_version = '2';

// Nothing in the app uploads to Storage: images are external URLs pasted
// into the admin forms. The previous uploads/ rule also ran a cross-service
// firestore.exists() lookup (a billed read) on every write attempt. Locked
// down entirely; re-add a scoped rule here if uploads are ever introduced.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
