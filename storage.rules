rules_version = '2';

// Images are served publicly (they're embedded in public pages — blog
// posts, service pages), but only admins can upload/replace/delete them.
// Cross-references the same Firestore admins/{uid} allowlist used by
// firestore.rules, so there's one source of truth for "who is an admin"
// rather than two to keep in sync.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
